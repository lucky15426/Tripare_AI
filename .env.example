# Copy to .env and adjust. Never commit .env.
# docker compose reads this file automatically.

# ---------- Backend ----------
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API ("*" = any)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Dev-only endpoints (supplier failure simulation). Defaults to true outside production.
ENABLE_DEV_ENDPOINTS=true

# ---------- Redis ----------
CACHE_TTL_SECONDS=300
DEGRADED_CACHE_TTL_SECONDS=30

# ---------- Temporal ----------
# Single-service deploys (e.g. one Render web service): run Temporal + the worker inside the API process.
EMBEDDED_TEMPORAL=false
# Or only the worker in-process, against an external Temporal:
RUN_WORKER=false
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# Temporal Cloud / secured cluster only (leave empty for the bundled dev server):
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
# Link shown on the Workflows page (must be reachable from the browser)
TEMPORAL_UI_URL=http://localhost:8080

# ---------- Supplier resilience ----------
# SUPPLIER_A_URL / SUPPLIER_B_URL default to this same process; set them only for external suppliers.
SUPPLIER_TIMEOUT_MS=4000
SUPPLIER_RETRY_INITIAL_MS=500
SUPPLIER_RETRY_BACKOFF=2
SUPPLIER_RETRY_MAX_ATTEMPTS=3

# ---------- Mock supplier simulation (initial state) ----------
SUPPLIER_A_ENABLED=true
SUPPLIER_B_ENABLED=true
SUPPLIER_A_LATENCY_MS=250
SUPPLIER_B_LATENCY_MS=550
SUPPLIER_A_ERROR_RATE=0
SUPPLIER_B_ERROR_RATE=0

# ---------- Optional integrations (leave empty to use graceful fallbacks) ----------
OPENWEATHER_API_KEY=
GEOAPIFY_API_KEY=
FRANKFURTER_URL=https://api.frankfurter.app

# ---------- Frontend (build-time, browser-facing URL of the API) ----------
VITE_API_BASE_URL=http://localhost:4000
