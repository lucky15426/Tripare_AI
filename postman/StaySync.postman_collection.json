    {
      "name": "17 Supplier failure simulation (dev only)",
      "item": [
        {
          "name": "17a Simulate Supplier A failure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dev/suppliers/supplierA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dev",
                "suppliers",
                "supplierA"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "17b Simulate Supplier B failure",
          "request": {
            "method": "POST",
            "header": [
