{
  "info": {
    "name": "StaySync - Hotel Offer Orchestrator",
    "description": "Run the stack first (docker compose up --build). Variables: baseUrl, city, minPrice, maxPrice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "city",
      "value": "delhi"
    },
    {
      "key": "minPrice",
      "value": "3000"
    },
    {
      "key": "maxPrice",
      "value": "8000"
    }
  ],
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
              "pm.test('Reports every service', () => { const s = pm.response.json().services; pm.expect(s).to.have.all.keys('api','redis','temporal','supplierA','supplierB'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Delhi hotel search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Returns deduplicated hotels sorted by price asc', () => { const p = j.data.map(h => h.price); pm.expect(p).to.eql([...p].sort((a,b)=>a-b)); });",
              "pm.test('X-Cache header present', () => pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT','MISS']));",
              "pm.test('One hotel per name', () => { const n = j.data.map(h => h.slug); pm.expect(new Set(n).size).to.eql(n.length); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Mumbai hotel search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=mumbai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "mumbai"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Has hotels', () => pm.expect(pm.response.json().data.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 City with no hotels",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=atlantis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "atlantis"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Empty data, not an error', () => { const j = pm.response.json(); pm.expect(j.data).to.eql([]); pm.expect(j.meta.totalHotels).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Price-filtered search (min + max)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city={{city}}&minPrice={{minPrice}}&maxPrice={{maxPrice}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "{{city}}"
            },
            {
              "key": "minPrice",
              "value": "{{minPrice}}"
            },
            {
              "key": "maxPrice",
              "value": "{{maxPrice}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All prices within range', () => { const lo = Number(pm.collectionVariables.get('minPrice')||pm.environment.get('minPrice')), hi = Number(pm.collectionVariables.get('maxPrice')||pm.environment.get('maxPrice')); pm.response.json().data.forEach(h => pm.expect(h.price).to.be.within(lo, hi)); });"
            ]
          }
        }
      ]
    },
